# Copy to .env for local use. Render: enter these in Environment instead.
# Supabase Connect > Session pooler URI, with URL-encoded database password.
DATABASE_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
APP_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
COOKIE_SECURE=false
ENVIRONMENT=production
SEED_DEMO=false
IMPORT_LEGACY_V2=false
# Leave ALL bootstrap values blank to register a college through the web screen.
BOOTSTRAP_COLLEGE_NAME=
BOOTSTRAP_COLLEGE_DOMAIN=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
